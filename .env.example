# Copy this file to .env (not committed to git) and fill in your real values.
# Get these from Supabase Dashboard -> Settings -> API.

VITE_SUPABASE_URL=https://xeevtplkzbheflxkunqo.supabase.co
VITE_SUPABASE_ANON_KEY=paste_your_anon_or_publishable_key_here

# Ask Tim. SERVER-SIDE ONLY — note there is no VITE_ prefix, deliberately:
# anything prefixed VITE_ is compiled into the browser bundle and readable
# by anyone who opens devtools. Get a key from console.anthropic.com and
# set it in Vercel -> Settings -> Environment Variables as well, or Tim
# works locally and not on the live site.
ANTHROPIC_API_KEY=paste_your_anthropic_key_here
